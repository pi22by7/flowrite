# Optional Supabase Configuration (leave blank for local-only or WebDAV)
# Get these from your Supabase dashboard: Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Google OAuth Client IDs
# Create these in Google Cloud Console
GOOGLE_WEB_CLIENT_ID=your_web_client_id.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID=your_android_client_id.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=your_ios_client_id.apps.googleusercontent.com

# Deep Link Scheme (usually doesn't need to change)
DEEP_LINK_SCHEME=me.pi22by7.flowrite://login-callback
