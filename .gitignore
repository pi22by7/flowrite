# Miscellaneous
*.class
*.log
*.pyc
__pycache__/
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/
migrate_working_dir/
.claude/

# Environment variables (contains sensitive data)
.env

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/
.kotlin/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/deploy/*
!/deploy/nginx.conf
!/deploy/15-local-resolver.sh
!/deploy/selfhost.env.example
!/deploy/webdav/
/deploy/webdav/*
!/deploy/webdav/Dockerfile
!/deploy/webdav/entrypoint.sh
!/deploy/webdav/httpd.conf

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Environment and Configuration Files
.env
.env.*
!.env.example

# Firebase Service Account Keys
**/service-account-*.json
**/serviceAccountKey.json
firebase-adminsdk-*.json

# Other Secret Files
secrets.json
config/secrets.yml

# Local self-hosting credentials
/deploy/selfhost.env

/backups/

# Local agent state and cloud credentials
/.agents/
/.codex/
/.aws/
